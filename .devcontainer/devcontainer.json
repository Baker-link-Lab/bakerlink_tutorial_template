{
    "name": "{{project-name}}",
    "dockerComposeFile": "../.docker/compose.yaml",
    "service": "{{project-name}}",
    "workspaceFolder": "/{{project-name}}",
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "fill-labs.dependi"
            ]
        }
    }
}